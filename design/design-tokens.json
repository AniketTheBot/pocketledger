{
  "app": {
    "name": "PocketLedger",
    "package": "app.pocketledger",
    "platform": "android",
    "stack": "Kotlin + Jetpack Compose + Material3 + Room + DataStore (native); themes map via lightColorScheme/darkColorScheme"
  },
  "chosen": {
    "layout": "sticker-ledger",
