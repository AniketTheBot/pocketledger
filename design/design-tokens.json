  "layouts": [
    {
      "id": "classic-ledger",
      "label": "Layout A - Classic Ledger",
      "nav": "bottom tabs x4",
      "home": "balance hero card + day-grouped list + FAB",
      "screens": ["onboarding keypad", "home", "accounts", "review"],
      "notes": "Original structure. Works with any theme."
    },
    {
      "id": "card-wallet",
      "label": "Layout B - Card Wallet",
      "nav": "hamburger drawer",
      "home": "horizontal swipeable account cards with sparklines + flat recent feed",
      "screens": ["home carousel", "drawer", "review full screen"],
      "notes": "Accounts-as-home. FAB bottom right."
    },
    {
      "id": "timeline-journal",
      "label": "Layout C - Timeline Journal",
      "nav": "overflow menu -> bottom sheet",
      "home": "chronological spine timeline with time rail, day bubbles, system scan events",
      "screens": ["timeline", "nav sheet", "entry sheet with keypad"],
      "notes": "Chronicle-first. Reconcile appears as a manual event on the spine."
    },
    {
      "id": "pulse-dashboard",
      "label": "Layout D - Pulse Dashboard",
      "nav": "floating pill bar with docked center FAB",
      "home": "stats-first: net balance + weekly in/out bars + stat tiles + compact feed",
      "screens": ["dashboard", "insights", "entry full screen"],
      "notes": "Insight-first. Insights page has donut + category bars."
    },
    {
      "id": "sticker-ledger",
      "label": "Layout E - Sticker Ledger (CHOSEN)",
      "nav": "black pill bottom bar: Home / Accounts / Review / Settings; active item = yellow pill",
      "home": "greeting + avatar; balance StickerCard with Record + Scan SMS pills; accounts avatar row; Recent Transactions feed; floating + FAB",
      "screens": ["sticker onboarding (flower promises)", "exact-balance keypad", "home", "accounts", "review", "entry", "reconcile", "settings"],
      "notes": "Implemented exactly as mockups/design-5-sticker-ledger.html. Bottom bar lives in Scaffold bottomBar so feeds never clip. Flower stickers drawn with Canvas scallop path."
    }
  ]
